{
  "_comment": "Maps job-description text to input/master-resume-{track}.md files. The 'tracks' object is authoritative: a track absent from it has no file and cannot be selected. Data only - the selection algorithm lives in Step 3 of .claude/skills/resume-jd-optimizer/SKILL.md.",
  "version": 3,
  "updated": "2026-09-12",
  "rules": {
    "min_keyword_hits": 2,
    "secondary_threshold": 0.5
  },
  "tracks": {
    "fs": {
      "file": "input/master-resume-fs.md",
      "label": "Full Stack Engineer",
      "default_secondary": null,
      "titles": [
        "full stack", "fullstack", "full-stack", "software engineer", "software developer",
        "web developer", "application developer", "frontend", "front end", "front-end",
        "react developer", "ui engineer", "backend", "back end", "back-end",
        "python engineer", "python developer", "api engineer"
      ],
      "keywords": [
        "full stack", "web application", "frontend", "backend", "rest api", "react",
        "next.js", "typescript", "javascript", "python", "django", "fastapi", "component",
        "responsive", "accessible forms", "crud", "single page application",
        "production support"
      ],
      "caveats": []
    },
    "data": {
      "file": "input/master-resume-data.md",
      "label": "Data Engineer",
      "default_secondary": "fs",
      "titles": [
        "data engineer", "analytics engineer", "etl developer", "bi engineer",
        "reporting engineer", "data platform"
      ],
      "keywords": [
        "sql", "postgresql", "etl", "elt", "pipeline", "ingestion", "pandas",
        "data validation", "data quality", "deduplication", "batch job", "reporting",
        "query tuning", "indexing", "caching", "redis", "analytics", "warehouse"
      ],
      "caveats": []
    },
    "devops": {
      "file": "input/master-resume-devops.md",
      "label": "Cloud / DevOps Engineer",
      "default_secondary": "fs",
      "titles": [
        "devops", "sre", "site reliability", "platform engineer", "release engineer",
        "build engineer", "infrastructure engineer", "cloud engineer"
      ],
      "keywords": [
        "docker", "container", "ci/cd", "github actions", "jenkins", "aws", "ec2", "s3",
        "linux", "bash", "nginx", "deployment", "release", "rollback", "monitoring",
        "application logs", "observability", "on-call"
      ],
      "caveats": [
        {
          "when": [
            "kubernetes", "k8s", "terraform", "infrastructure as code", "iac", "helm",
            "ansible", "cluster", "service mesh"
          ],
          "action": "select_anyway",
          "log": "No infrastructure-as-code or cluster work is recorded. devops is the closest track; claim none of this. Needs real infrastructure work in input/projects.md."
        }
      ]
    },
    "enterprise": {
      "file": "input/master-resume-enterprise.md",
      "label": "Enterprise Integration Engineer",
      "default_secondary": "fs",
      "titles": [
        "integration engineer", "erp", "business systems", "solutions engineer",
        "business applications", "systems analyst"
      ],
      "keywords": [
        "erp", "crm", "itsm", "accounting system", "integration", "scheduled data exchange",
        "order entry", "inventory", "management reporting", "approval workflow",
        "internal tools", "back office", "e-commerce", "role-based access control",
        "business process"
      ],
      "caveats": [
        {
          "when": [
            "sap", "salesforce", "netsuite", "servicenow", "workday", "dynamics",
            "oracle erp", "peoplesoft"
          ],
          "action": "select_anyway",
          "log": "No named ERP or CRM vendor platform is recorded, only generic ERP and accounting integration over REST APIs and scheduled data exchange. Add real platform names to Section 1 if the candidate has used them."
        }
      ]
    },
    "ai": {
      "file": "input/master-resume-ai.md",
      "label": "AI Engineer",
      "default_secondary": "fs",
      "titles": [
        "ai engineer", "ml engineer", "machine learning engineer", "llm", "genai",
        "generative ai", "applied ai", "ai developer"
      ],
      "keywords": [
        "llm", "rag", "retrieval-augmented", "embeddings", "vector", "pgvector",
        "semantic search", "prompt", "structured outputs", "genai", "ai application",
        "openai", "anthropic", "chatbot", "machine learning"
      ],
      "caveats": [
        {
          "always": true,
          "action": "select_anyway",
          "log": "AI-Assisted Case Servicing Copilot and AI-Assisted Reconciliation Triage in input/projects.md evidence LLM API integration, RAG, semantic retrieval, summarization, classification, anomaly scoring and their safeguards, at First Horizon Bank from July 2022. Neither records a model provider, vector store, embedding model, framework, evaluation method, or any accuracy, adoption or time-saved figure. Claim the capability and the guardrails, never a named tool and never an AI number."
        },
        {
          "when": [
            "python", "pandas", "numpy", "pytorch", "tensorflow", "scikit-learn", "fine-tune",
            "fine-tuning", "model training", "mlops", "agent", "agentic", "tool calling",
            "evaluation harness", "llm-as-judge"
          ],
          "action": "select_anyway",
          "log": "Recorded AI work is Java and Spring Boot applied-AI integration only. Python and its AI ecosystem, model training and fine-tuning, MLOps, agentic tool-calling and formal evaluation harnesses are recorded nowhere. If the posting makes one a hard bar, report a structural mismatch rather than bridging to it."
        }
      ]
    }
  },
  "domain_boost": {
    "_comment": "Healthcare delivery is recorded behind these tracks, so a healthcare posting favours them. Adds 'points' to each track's keyword score.",
    "keywords": [
      "healthcare", "health plan", "medicaid", "medicare", "marketplace", "claims",
      "provider data", "phi", "protected health information", "member services", "payer",
      "eligibility"
    ],
    "boost_tracks": ["fs", "data", "enterprise"],
    "points": 1
  },
  "global_caveats": [
    {
      "when": ["8+ years", "9+ years", "10+ years", "10 years", "12 years", "15 years", "decade of"],
      "action": "select_anyway",
      "log": "Record supports 7+ years, March 2019 to present. Do not inflate the headline or summary. If the JD makes the year count a hard bar, log a structural mismatch."
    },
    {
      "when": ["linkedin", "github", "portfolio", "link to your profile"],
      "action": "select_anyway",
      "log": "No LinkedIn or GitHub URL is recorded in Sections 5 and 6 of input/profile.md, so those fields are omitted from the contact line. Add real URLs to close this."
    }
  ],
  "no_fit": {
    "_comment": "No track file covers these. Use fallback_track as primary with no secondary, and log the mismatch at Step 8.",
    "fallback_track": "fs",
    "log": "JD is outside every track the record covers. Generated from master-resume-fs.md as the general software engineering fallback.",
    "keywords": [
      "security engineer", "soc analyst", "penetration testing", "pentest",
      "incident response", "grc", "compliance auditor", "it support", "service desk",
      "help desk", "sysadmin", "desktop support", "ios", "android", "swift", "kotlin",
      "react native", "flutter", "mobile developer", "product manager", "program manager",
      "product owner", "technical writer", "documentation engineer", "solidity",
      "smart contract", "web3", "blockchain", "mechanical engineer", "civil engineer",
      "electrical engineer", "fire protection", "structural engineer"
    ]
  },
  "examples": {
    "_comment": "Primary comes from the title; secondary is scored against the whole posting body, so these assume a full JD.",
    "cases": [
      {
        "jd": "Senior Python Engineer, healthcare SaaS",
        "primary": "fs",
        "secondary": "data",
        "why": "title hit on 'python engineer', domain_boost applies"
      },
      {
        "jd": "Data Engineer, ETL and reporting",
        "primary": "data",
        "secondary": "fs",
        "why": "title hit on 'data engineer'"
      },
      {
        "jd": "Full Stack Engineer with AI features",
        "primary": "fs",
        "secondary": "ai",
        "why": "title hit on 'full stack', ai scores above threshold on keywords"
      },
      {
        "jd": "DevOps Engineer, Kubernetes required",
        "primary": "devops",
        "secondary": "fs",
        "why": "title hit, but the kubernetes caveat fires and must be logged"
      },
      {
        "jd": "ERP Integration Developer, NetSuite",
        "primary": "enterprise",
        "secondary": "fs",
        "why": "title hit on 'erp', vendor caveat fires and must be logged"
      },
      {
        "jd": "iOS Engineer",
        "primary": "fs",
        "secondary": null,
        "why": "no_fit hit on 'ios', falls back and logs the mismatch"
      }
    ]
  }
}
